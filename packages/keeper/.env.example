# Chain to run against: "anvil" (default) or "sepolia"
KEEPER_CHAIN=anvil

# Dedicated keeper key. Minimal funds: it only pays gas for performUpkeep (1 tx/day).
KEEPER_PRIVATE_KEY=0x...

# Override presets below only if needed.

# KEEPER_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# KEEPER_CONTRACT_ADDRESS=0x...

# Poll interval in milliseconds (default: 60000)
# KEEPER_POLL_INTERVAL_MS=60000

# Warn when the keeper balance drops below this (wei, default: 0.005 ETH)
# KEEPER_MIN_BALANCE_WEI=5000000000000000
